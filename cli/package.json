{
  "name": "slop-ai-indo",
  "version": "1.2.1",
  "description": "Interactive installer for slop-ai-indo skills and design standards (Bahasa Indonesia).",
  "type": "module",
  "bin": {
    "slop-ai-indo": "index.mjs",
    "slop-lint": "bin/slop-lint.mjs",
    "slop-mcp": "bin/slop-mcp.mjs"
  },
  "license": "MIT",
  "author": "Yanuar (yanuar1997)",
  "homepage": "https://github.com/yanuar1997/slop-ai-indo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanuar1997/slop-ai-indo.git"
  },
  "keywords": [
    "ai-slop",
    "anti-slop",
    "design-rules",
    "copy-rules",
    "agent-skills",
    "ui",
    "indonesia",
    "accessibility"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin/",
    "index.mjs",
    "lib/",
    "skills/",
    "presets/",
    "DESIGN.md",
    "slop-ai-indo.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/smoke-test.mjs && node scripts/test-linter.mjs && node scripts/test-mcp.mjs && node scripts/test-hook.mjs",
    "sync-skills": "node scripts/sync-skills.mjs",
    "prepublishOnly": "npm run sync-skills",
    "test:linter": "node scripts/test-linter.mjs",
    "test:mcp": "node scripts/test-mcp.mjs",
    "test:hook": "node scripts/test-hook.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "picocolors": "^1.1.1"
  }
}
